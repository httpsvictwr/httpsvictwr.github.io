:root {
    --primary-color: #2563eb;
    --bg-color: #0f172a;
    --card-bg: #1e293b;
    --text-color: #e2e8f0;
    --text-muted: #94a3b8;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: var(--bg-color);
    color: var(--text-color);
    line-height: 1.6;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 10%;
    background: rgba(15, 23, 42, 0.9);
    position: sticky;
    top: 0;
    border-bottom: 1px solid #334155;
    z-index: 100;
}

.logo {
    font-weight: bold;
    font-size: 1.2rem;
    color: #60a5fa;
}

nav a {
    color: var(--text-muted);
    text-decoration: none;
    margin-left: 20px;
    transition: color 0.3s;
}

nav a:hover {
    color: #60a5fa;
}

.hero {
    height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 20px;
    background: linear-gradient(135deg, #1e1b4b 0%, #0f172a 100%);
}

.hero h1 {
    font-size: 2.8rem;
    margin-bottom: 15px;
}

.destacado {
    color: #60a5fa;
}

.hero p {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto 25px auto;
}

.container {
    max-width: 1000px;
    margin: 60px auto;
    padding: 0 20px;
}

h2 {
    font-size: 2rem;
    margin-bottom: 20px;
    border-left: 4px solid #60a5fa;
    padding-left: 10px;
}

.grid-proyectos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 30px;
}

.card {
    background-color: var(--card-bg);
    padding: 25px;
    border-radius: 10px;
    border: 1px solid #334155;
    transition: transform 0.3s, border-color 0.3s;
}

.card:hover {
    transform: translateY(-5px);
    border-color: #60a5fa;
}

.card h3 {
    margin-bottom: 10px;
    color: #f8fafc;
}

.card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 15px;
}

.tag {
    background: #3b82f633;
    color: #60a5fa;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.8rem;
}

.btn {
    display: inline-block;
    background-color: var(--primary-color);
    color: white;
    padding: 10px 25px;
    border-radius: 5px;
    text-decoration: none;
    font-weight: 500;
    transition: background 0.3s;
}

.btn:hover {
    background-color: #1d4ed8;
}

.contacto-box {
    text-align: center;
    background: var(--card-bg);
    padding: 40px;
    border-radius: 12px;
    border: 1px solid #334155;
}

.contacto-box p {
    color: var(--text-muted);
    margin-bottom: 20px;
}

footer {
    text-align: center;
    padding: 30px;
    color: var(--text-muted);
    border-top: 1px solid #334155;
    font-size: 0.9rem;
}
